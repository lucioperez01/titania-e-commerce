# Base URL for server-side callbacks (webhooks, payment redirects)
# Do NOT use NEXT_PUBLIC_ prefix — this is server-side only
BASE_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/titania

# NextAuth
# Generate a secure random string: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-key-here
NEXTAUTH_URL=http://localhost:3000

# Google OAuth
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Admin
# Comma-separated list of admin emails. Users with these emails are auto-promoted to ADMIN role.
ADMIN_EMAIL=admin@titania.com,admin2@titania.com

# MercadoPago Checkout Pro
# Get credentials from: https://www.mercadopago.com/developers/panel/app
# Use Sandbox credentials for local development, Production for live.
MP_ACCESS_TOKEN=your-sandbox-access-token-here
MP_PUBLIC_KEY=your-sandbox-public-key-here
MP_WEBHOOK_SECRET=your-webhook-secret-here

# Payment feature flag
# Set to "true" to enable MercadoPago checkout flow. "false" keeps existing mock flow.
PAYMENTS_ENABLED=false

# Email (Resend)
# Get API key from: https://resend.com/api-keys
RESEND_API_KEY=re_your-api-key-here

# Cron Jobs
# Generate with: openssl rand -base64 32
# Used to authenticate Vercel cron requests. Set the same value in Vercel env vars.
CRON_SECRET=your-cron-secret-here

# Hours before a RESERVED order is automatically expired and stock released.
RESERVATION_TIMEOUT_HOURS=24

# Microsoft Clarity
# Get project ID from: https://clarity.microsoft.com/
# Used for heatmaps and session recordings (client-side only)
NEXT_PUBLIC_CLARITY_PROJECT_ID=your-clarity-project-id
